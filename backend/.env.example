# Stage 2C AI image assessment (optional overrides; defaults are auto-detected)
# CV_PYTHON_PATH=C:/path/to/reference-ml/stage2_cv/.venv-stage2/Scripts/python.exe
# CV_STAGE2_ROOT=C:/path/to/reference-ml/stage2_cv


NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/medflow
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
JWT_ISSUER=medflow-ai
JWT_AUDIENCE=medflow-ai-clients
CLIENT_URL=http://localhost:3010
ADMIN_URL=http://localhost:3011
# Development also accepts the equivalent 127.0.0.1 origins on these two ports.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Tiwari@1234
CLOUDINARY_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_SECRET_KEY=replace-with-cloudinary-secret-key
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret
CURRENCY=INR
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=VetFlow-AI <no-reply@example.com>
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
OTP_EXPIRES_IN=10m
OTP_MAX_ATTEMPTS=5
AUTH_LOCK_MAX_ATTEMPTS=5
AUTH_LOCK_DURATION=15m
COOKIE_NAME=medflow_refresh
COOKIE_SAME_SITE=lax
TWO_FACTOR_ENCRYPTION_KEY=replace-with-32-plus-byte-random-encryption-key
TOTP_ISSUER=MedFlow AI Enterprise
TOTP_SETUP_EXPIRES_IN=10m
TWO_FACTOR_CHALLENGE_EXPIRES_IN=5m
TWO_FACTOR_MAX_ATTEMPTS=5
RECOVERY_CODE_COUNT=10
DEFAULT_ORGANIZATION_NAME=VetFlow-AI Default Clinic
DEFAULT_ORGANIZATION_SLUG=medflow-default
LOG_LEVEL=info
SERVICE_NAME=medflow-backend
ENABLE_API_DOCS=false
# Local development only: when true and NODE_ENV is not production, newly
# registered patient accounts are marked verified and no verification email is sent.
# Production never honors this bypass.
DEVELOPMENT_AUTO_VERIFY_EMAIL=true
# Local development only: opt-in guard for fictional Phase 2C demo data seeding.
# The seed command refuses to run unless NODE_ENV=development and this is exactly true.
ALLOW_PHASE2C_DEMO_SEED=false
