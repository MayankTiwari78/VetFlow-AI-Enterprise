# =============================================================================
# VetFlow-AI backend — PRODUCTION environment (template).
# Copy to  deploy/env/backend.env.prod  and fill every value below.
# This file is git-ignored by design — NEVER commit the filled version.
#
# GENERATE STRONG SECRETS (run locally, paste the output):
#   JWT_ACCESS_SECRET / JWT_REFRESH_SECRET / TWO_FACTOR_ENCRYPTION_KEY:
#       openssl rand -base64 48
#   ADMIN_PASSWORD (strong, unique — do NOT reuse the old .env.example value):
#       openssl rand -base64 24
#
# The backend REFUSES TO BOOT in production if any required field is missing,
# still a "replace-with-..." placeholder, or if the two JWT secrets are equal
# (enforced in backend/src/config/env.ts).
# =============================================================================

NODE_ENV=production
PORT=4000

# ---- Database: MongoDB Atlas (SRV URI). Keep credentials only here. ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/medflow?retryWrites=true&w=majority

# ---- JWT: three DISTINCT long random secrets ----
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-long-random-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
JWT_ISSUER=vetflow-ai
JWT_AUDIENCE=vetflow-ai-clients

# ---- Public origins (Vercel apps call the Render API cross-origin). ----
# CLIENT_URL is the production patient app; add every other trusted web origin
# explicitly (comma separated). Vercel preview deployments for the project(s)
# below are accepted automatically.
CLIENT_URL=https://vet-flow-ai-enterprise.vercel.app
ADMIN_URL=https://admin.example.com

# Extra browser origins allowed to call the API (comma separated), on top of
# CLIENT_URL / ADMIN_URL, e.g. a Vercel admin console on its own domain.
CORS_ALLOWED_ORIGINS=

# Vercel projects whose deployment URLs may call the API:
#   https://<project>.vercel.app          (production domain)
#   https://<project>-<preview-suffix>.vercel.app  (preview deployments)
# Vercel previews are only ever accepted for the projects listed here; set an
# empty value to trust the explicit origins above only.
CORS_VERCEL_PREVIEW_PROJECTS=vet-flow-ai-enterprise

# The Vercel apps (https://*.vercel.app) and the Render API
# (https://*.onrender.com) are DIFFERENT registrable domains, so the httpOnly
# refresh cookie is cross-site and requires SameSite=None + Secure. Keep "none"
# whenever the browser apps and the API are on different domains.
COOKIE_SAME_SITE=none

# ---- Bootstrap admin account. USE A STRONG, UNIQUE PASSWORD. ----
# (The old committed .env.example shipped ADMIN_PASSWORD=Tiwari@1234 — do not
#  reuse it in production; it is publicly visible in git history.)
ADMIN_EMAIL=admin@your-clinic-domain.com
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password

# ---- Cloudinary (image storage). Production requires real, non-placeholder values. ----
CLOUDINARY_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_SECRET_KEY=replace-with-cloudinary-secret-key

# ---- Payments ----
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
CURRENCY=INR

# ---- Email / SMTP (required in production) ----
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=VetFlow-AI <no-reply@your-clinic-domain.com>

# ---- Expiries / lockout (safe defaults) ----
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
OTP_EXPIRES_IN=10m
OTP_MAX_ATTEMPTS=5
AUTH_LOCK_MAX_ATTEMPTS=5
AUTH_LOCK_DURATION=15m

# ---- Two-factor (TOTP). Encryption key must be >= 32 bytes of randomness. ----
TWO_FACTOR_ENCRYPTION_KEY=replace-with-32-plus-byte-random-encryption-key
TOTP_ISSUER=VetFlow-AI Enterprise
TOTP_SETUP_EXPIRES_IN=10m
TWO_FACTOR_CHALLENGE_EXPIRES_IN=5m
TWO_FACTOR_MAX_ATTEMPTS=5
RECOVERY_CODE_COUNT=10

# ---- Org defaults / logging ----
DEFAULT_ORGANIZATION_NAME=VetFlow-AI Default Clinic
DEFAULT_ORGANIZATION_SLUG=vetflow-default
LOG_LEVEL=info
SERVICE_NAME=vetflow-backend

# ---- Production hardening: keep these OFF ----
ENABLE_API_DOCS=false
DEVELOPMENT_AUTO_VERIFY_EMAIL=false
ALLOW_PHASE2C_DEMO_SEED=false
STAGE3_LLM_ENABLED=false

# ---- Python inference (set by Dockerfile.prod; override only if needed) ----
# STAGE1_PYTHON_PATH=/opt/ml-venv/bin/python
# CV_PYTHON_PATH=/opt/ml-venv/bin/python
# CV_STAGE2_ROOT is injected by docker-compose.prod.yml (=/opt/stage2_cv).
