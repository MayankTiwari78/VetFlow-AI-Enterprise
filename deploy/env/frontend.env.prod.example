# =============================================================================
# Frontend (pet-owner) — PRODUCTION public build vars.
#
# In the single-VM Docker setup you normally DO NOT need this file:
# docker-compose.prod.yml passes these as BUILD ARGS (from deploy/.env).
# Kept for manual / non-Docker `next build` runs.
#
# NEXT_PUBLIC_* values are embedded in the client bundle at BUILD time, so they
# must be set before `npm run build` — changing them later needs a rebuild.
# =============================================================================
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
