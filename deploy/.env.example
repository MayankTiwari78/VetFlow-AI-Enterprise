# =============================================================================
# Compose-level interpolation variables for docker-compose.prod.yml.
# Copy to deploy/.env  ->  `cp .env.example .env`  ->  then edit.
# (This file holds only PUBLIC build values + host paths — no secrets.)
# =============================================================================

# Public HTTPS URL of the backend API. Baked into BOTH web bundles at build
# time (NEXT_PUBLIC_BACKEND_URL). Must match the api.<domain> in Caddyfile.
PUBLIC_API_URL=https://api.example.com

# Public Razorpay key id for pet-owner checkout (publishable id, NOT a secret).
PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx

# Currency label shown in the admin console.
PUBLIC_CURRENCY=INR

# Host path to the Stage-2 CV code + weights (reference-ml/stage2_cv) on the VM.
# The default assumes reference-ml sits next to MedFlow-AI-Enterprise (as in the
# current workspace). Uncomment + set an absolute path if you place it elsewhere.
# STAGE2_CV_HOST_PATH=/opt/vetflow/reference-ml/stage2_cv
