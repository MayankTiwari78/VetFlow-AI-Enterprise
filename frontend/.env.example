# Copy this file to frontend/.env and replace the placeholder values (.env is git-ignored).
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Must be the SAME Razorpay Key ID the backend uses (backend/.env RAZORPAY_KEY_ID).
# A mismatched or placeholder Key ID makes Razorpay Checkout fail ("Payment Failed").
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
